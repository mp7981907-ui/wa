# Required: keep this secret. Used for API/dashboard actions.
API_KEY=change-this-long-random-key

# Hostinger injects PORT automatically. Locally defaults to 3000.
PORT=3000

# Optional UI branding
APP_NAME=WP Automation by Ritik
BUSINESS_NAME=Your Business

# Optional automation defaults
WELCOME_MESSAGE=Hi! Thanks for messaging us. How can we help you today?
OFFICE_HOURS=10:00-19:00
